<mxfile host="drawio" version="24.7.17">
  <diagram id="drift-decision" name="Drift decision">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1000" pageHeight="1800" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Drift detection: how a column is judged drifted" style="text;html=0;fontSize=20;fontStyle=1;fontColor=#1A1A19;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="620" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ref" value="Reference data&#xa;rows loaded when the model was trained&#xa;(raw snapshot, before preprocessing and split)" style="rounded=1;html=0;arcSize=10;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cur" value="Current data&#xa;uploaded CSV or Parquet&#xa;in the same raw format" style="rounded=1;html=0;arcSize=10;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="50" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="prep" value="Backend: drop the target and explicitly dropped columns on both sides" style="rounded=1;html=0;arcSize=10;fillColor=#FFF4E5;strokeColor=#D79B00;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="600" height="44" as="geometry" />
        </mxCell>
        <mxCell id="core" value="skyulf-core: DriftCalculator.calculate_drift" style="rounded=1;html=0;arcSize=2;fillColor=#EAF7EE;strokeColor=#82B366;fontColor=#1A1A19;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="940" height="1234" as="geometry" />
        </mxCell>
        <mxCell id="q_common" value="Column in both&#xa;datasets?" style="rhombus;html=0;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="300" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="schema" value="Schema drift&#xa;missing_columns, new_columns" style="rounded=1;html=0;arcSize=10;fillColor=#FDECEC;strokeColor=#B85450;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="315" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q_values" value="Non-null values&#xa;on both sides?" style="rhombus;html=0;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="450" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="unscored" value="Not scored&#xa;(no column_drifts entry)" style="rounded=1;html=0;arcSize=10;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="465" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q_type" value="Current type&#xa;compatible?" style="rhombus;html=0;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="600" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="typedrift" value="type_drift: drifted, no evidence test&#xa;e.g. text that is not numeric,&#xa;or Date compared with Datetime" style="rounded=1;html=0;arcSize=10;fillColor=#FDECEC;strokeColor=#B85450;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="605" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="numeric" value="Numeric, Date, Datetime&#xa;wasserstein_distance / reference std&#xa;ks_statistic (two-sample KS)&#xa;psi (up to 10 reference bins)&#xa;kl_divergence (same bins)&#xa;ks_test_p_value: evidence only" style="rounded=1;html=0;arcSize=6;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="categorical" value="String, Categorical, Enum, Boolean&#xa;psi_categorical (category shares)&#xa;over 50 reference categories:&#xa;top 50 plus one pooled tail,&#xa;new_category_rate (diagnostic only);&#xa;ID-like columns (over 50% unique) skipped" style="rounded=1;html=0;arcSize=6;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="750" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="effect" value="Effect: any metric value &gt; its threshold&#xa;defaults psi 0.2, ks_statistic 0.1, wasserstein 0.1, kl_divergence 0.1&#xa;(psi_categorical uses psi; thresholds can be overridden per check)" style="rounded=1;html=0;arcSize=10;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="600" height="64" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="Statistical evidence, after every column is measured&#xa;numeric: KS p-value; categorical: Fisher exact (2 categories),&#xa;chi-square (observed and expected cells at least 5) or per-category Fisher&#xa;Bonferroni across the tested columns, significance level 0.05&#xa;status: supported, not_detected, insufficient_data, unavailable" style="rounded=1;html=0;arcSize=6;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1064" width="600" height="104" as="geometry" />
        </mxCell>
        <mxCell id="q_verdict" value="Effect AND&#xa;evidence&#xa;supported?" style="rhombus;html=0;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="1234" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="drifted" value="Drifted&#xa;drift_detected = true" style="rounded=1;html=0;arcSize=10;fillColor=#FDECEC;strokeColor=#B85450;fontColor=#1A1A19;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="1259" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="notdrifted" value="Not drifted&#xa;evidence reason, if any, is the suggestion" style="rounded=1;html=0;arcSize=10;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="1404" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="report" value="DriftReport&#xa;drifted_columns_count = drifted columns + missing columns + new columns&#xa;per-column metrics, evidence and suggestions" style="rounded=1;html=0;arcSize=10;fillColor=#F3E8FF;strokeColor=#9673A6;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1534" width="900" height="64" as="geometry" />
        </mxCell>
        <mxCell id="alert" value="Backend alert history: one DriftCheckResult row per check&#xa;evaluation_status completed, no_baseline or failed; completed checks pin the threshold set to a version&#xa;severity: critical (schema drift, or over 30% of scored columns drifted), warning (any drifted), else none&#xa;status: new, acknowledged, resolved; reopen from acknowledged or resolved" style="rounded=1;html=0;arcSize=8;fillColor=#FFF4E5;strokeColor=#D79B00;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
