<mxfile host="drawio" version="24.7.17">
  <diagram id="project-export" name="Exported model project">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1000" pageHeight="520" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Exported model project: what the ZIP holds and how it runs" style="text;html=0;fontSize=20;fontStyle=1;fontColor=#1A1A19;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="760" height="34" as="geometry" />
        </mxCell>
        <mxCell id="g_kayra" value="In Kayra" style="rounded=1;html=0;arcSize=4;fillColor=#F7FAFF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="230" height="420" as="geometry" />
        </mxCell>
        <mxCell id="k_registry" value="Model Registry&#xa;pick a completed version,&#xa;choose API + batch, API only&#xa;or Batch only; Export project" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#EAF2FF;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="k_server" value="Kayra server builds the ZIP&#xa;loads the job's saved model,&#xa;refuses unsupported pipelines;&#xa;no deployment needed" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="30" y="256" width="210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="g_zip" value="kayra_model_&lt;job id&gt;.zip" style="rounded=1;html=0;arcSize=4;fillColor=#F3E8FF;strokeColor=#9673A6;fontColor=#1A1A19;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="50" width="350" height="420" as="geometry" />
        </mxCell>
        <mxCell id="z_model" value="Model and its contract&#xa;model.pkl: fitted preprocessing and model&#xa;schema.json: raw input columns and dtypes&#xa;manifest.json: job, versions, model SHA256" style="rounded=1;html=0;arcSize=8;fontColor=#1A1A19;fontSize=12;fillColor=#FFFFFF;strokeColor=#9673A6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="312" y="84" width="326" height="76" as="geometry" />
        </mxCell>
        <mxCell id="z_scorer" value="Shared scorer&#xa;scoring.py: used by every entry point" style="rounded=1;html=0;arcSize=8;fontColor=#1A1A19;fontSize=12;fillColor=#FFFFFF;strokeColor=#9673A6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="312" y="172" width="326" height="46" as="geometry" />
        </mxCell>
        <mxCell id="z_entry" value="Entry points, chosen by export mode&#xa;app.py: HTTP API (API only, API + batch)&#xa;batch.py: file scoring (Batch only, API + batch)" style="rounded=1;html=0;arcSize=8;fontColor=#1A1A19;fontSize=12;fillColor=#FFFFFF;strokeColor=#9673A6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="312" y="230" width="326" height="62" as="geometry" />
        </mxCell>
        <mxCell id="z_install" value="Install&#xa;requirements.txt: exact package versions&#xa;wheels/: the bundled skyulf-core wheel&#xa;Dockerfile, .dockerignore" style="rounded=1;html=0;arcSize=8;fontColor=#1A1A19;fontSize=12;fillColor=#FFFFFF;strokeColor=#9673A6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="312" y="304" width="326" height="76" as="geometry" />
        </mxCell>
        <mxCell id="z_help" value="Helpers&#xa;smoke_test.py, example_request.json,&#xa;README.md" style="rounded=1;html=0;arcSize=8;fontColor=#1A1A19;fontSize=12;fillColor=#FFFFFF;strokeColor=#9673A6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="312" y="392" width="326" height="62" as="geometry" />
        </mxCell>
        <mxCell id="g_run" value="Anywhere, without the Kayra server" style="rounded=1;html=0;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1A1A19;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="50" width="290" height="420" as="geometry" />
        </mxCell>
        <mxCell id="r_api" value="HTTP API (app.py)&#xa;uvicorn app:app&#xa;POST /predict: JSON in and out&#xa;GET /health, GET /schema" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="712" y="84" width="246" height="76" as="geometry" />
        </mxCell>
        <mxCell id="r_batch" value="Batch (batch.py)&#xa;CSV or Parquet file in chunks;&#xa;writes rows + prediction columns" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="712" y="200" width="246" height="66" as="geometry" />
        </mxCell>
        <mxCell id="r_pred" value="Predictor (scoring.py)&#xa;checks the model.pkl SHA256&#xa;against manifest.json, loads it,&#xa;converts inputs by schema.json,&#xa;runs the saved preprocessing&#xa;and the model" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#EAF7EE;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="712" y="326" width="246" height="124" as="geometry" />
        </mxCell>
        <mxCell id="e_export" value="POST /api/deployment/&#xa;export/{job_id}?mode=..." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k_registry" target="k_server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_zip" value="ZIP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.66;entryDx=0;entryDy=0;" edge="1" parent="1" source="k_server" target="g_zip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_install" value="unzip,&#xa;install" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_zip" target="g_run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_api" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_api" target="r_pred">
