<mxfile host="drawio" version="24.7.17">
  <diagram id="app-map" name="Kayra app map">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1000" pageHeight="600" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Kayra app: the sidebar pages in the order of a typical project" style="text;html=0;fontSize=20;fontStyle=1;fontColor=#1A1A19;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="760" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p_data" value="1. Data Sources&#xa;upload a file or connect S3" style="rounded=1;html=0;arcSize=10;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="220" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p_eda" value="2. EDA&#xa;profile a dataset: correlations,&#xa;outliers, target analysis" style="rounded=1;html=0;arcSize=10;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="60" width="220" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p_canvas" value="3. ML Canvas (Canvas view)&#xa;build a pipeline from nodes,&#xa;Preview data, train or tune" style="rounded=1;html=0;arcSize=10;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="220" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p_jobs" value="4. Jobs page, Experiments view&#xa;follow jobs as they run,&#xa;compare metrics of runs" style="rounded=1;html=0;arcSize=10;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="60" width="220" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p_registry" value="5. Model Registry&#xa;completed train/tune jobs&#xa;as versions; Deploy, Export" style="rounded=1;html=0;arcSize=10;fillColor=#F3E8FF;strokeColor=#9673A6;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="200" width="220" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p_deploy" value="6. Deployments&#xa;the one active model, deployed&#xa;from Experiments or Registry" style="rounded=1;html=0;arcSize=10;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="200" width="220" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p_infer" value="7. Inference (ML Canvas view)&#xa;send rows to the active model,&#xa;read the predictions" style="rounded=1;html=0;arcSize=10;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="200" width="220" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p_drift" value="8. Data Drift&#xa;upload new data, compare it&#xa;with a trained job's reference" style="rounded=1;html=0;arcSize=10;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="220" height="76" as="geometry" />
        </mxCell>
        <mxCell id="g_any" value="Any time" style="rounded=1;html=0;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1A1A19;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="320" width="970" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p_dash" value="Dashboard&#xa;totals, recent jobs,&#xa;quick links" style="rounded=1;html=0;arcSize=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="355" width="215" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p_errors" value="Error Log&#xa;server errors (5xx) and&#xa;pipeline failures" style="rounded=1;html=0;arcSize=10;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="275" y="355" width="215" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p_slow" value="Slow Nodes&#xa;step runtimes from&#xa;completed jobs" style="rounded=1;html=0;arcSize=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="355" width="215" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p_audit" value="Audit Log&#xa;history of canvas saves:&#xa;who, when, which nodes" style="rounded=1;html=0;arcSize=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="745" y="355" width="225" height="66" as="geometry" />
