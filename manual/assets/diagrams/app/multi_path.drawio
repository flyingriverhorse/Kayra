<mxfile host="drawio" version="24.7.17">
  <diagram id="multi-path" name="Multi-path pipelines">
    <mxGraphModel dx="1200" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1000" pageHeight="950" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Multi-path canvas: from one graph to parallel jobs" style="text;html=0;fontSize=20;fontStyle=1;fontColor=#1A1A19;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="u_click" value="Run All Experiments (toolbar), or&#xa;Train model / Tune model on one node" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=13;fillColor=#EAF2FF;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="290" y="50" width="420" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b_check" value="Server checks the graph for leakage&#xa;(POST /api/pipeline/run)" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="290" y="156" width="420" height="56" as="geometry" />
        </mxCell>
        <mxCell id="f_reject" value="Rejected with HTTP 400;&#xa;no job is created" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FDECEC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="156" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b_split" value="Split into branches&#xa;canvas parts that are not connected become&#xa;separate groups; each model node is a branch.&#xa;A model node with 2+ inputs follows its toggle:" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="290" y="262" width="420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="b_target" value="Train / Tune on one node:&#xa;only the branches that&#xa;contain that node are kept" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFFFFF;strokeColor=#D79B00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="262" width="220" height="86" as="geometry" />
        </mxCell>
        <mxCell id="b_merge" value="Merge (default)&#xa;one branch; when it runs, the node&#xa;combines the data from all its inputs" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="20" y="408" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_parallel" value="Parallel&#xa;one branch per input path, each with its&#xa;own copy of the shared upstream nodes" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="530" y="408" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_jobs" value="One queued job per branch&#xa;a branch that is already queued or running&#xa;returns its existing job instead of a new one" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="290" y="538" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t_run" value="New jobs run at the same time&#xa;one Celery task, or threads in-process" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFE9C7;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="290" y="668" width="420" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b_rules" value="Inside a job: a node with 2+ inputs merges them&#xa;same row count: columns side by side; a column changed&#xa;by only one input keeps that change, other ties go to&#xa;the last input (or the first, if chosen)&#xa;different row counts: rows stacked on shared columns,&#xa;an error if no column is shared&#xa;train, validation and test are merged separately" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="784" width="460" height="124" as="geometry" />
        </mxCell>
        <mxCell id="o_results" value="Results&#xa;the Experiments view compares the branches;&#xa;the Jobs drawer lists every submitted job" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#F3E8FF;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="530" y="784" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_click" target="b_check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_check" target="f_reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="passes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_check" target="b_split">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=none;endFill=0;dashed=1;strokeColor=#D79B00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_target" target="b_split">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_split" target="b_merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_split" target="b_parallel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_merge" target="b_jobs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_parallel" target="b_jobs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_jobs" target="t_run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="during each job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;dashed=1;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_run" target="b_rules">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="completed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_run" target="o_results">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
