<mxfile host="drawio" version="24.7.17">
  <diagram id="canvas-how-it-works" name="How the ML Canvas runs a pipeline">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1000" pageHeight="800" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ML Canvas: Preview data versus training jobs" style="text;html=0;fontSize=20;fontStyle=1;fontColor=#1A1A19;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="g_canvas" value="On the canvas: each edge carries the data its source node outputs" style="rounded=1;html=0;arcSize=4;fillColor=#F7FAFF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="46" width="970" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n_data" value="Data source node&#xa;picks a dataset from&#xa;Data Sources" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#EAF2FF;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_split" value="Train-Test Split&#xa;train, validation and&#xa;test outputs" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#EAF2FF;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="286" y="86" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_prep" value="Preprocessing nodes&#xa;clean, impute, encode,&#xa;scale and more" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#EAF2FF;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="532" y="86" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_model" value="Model node&#xa;classification, regression,&#xa;text, ensemble, segmentation" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#EAF2FF;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="778" y="86" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a_preview" value="Preview data&#xa;toolbar button or Ctrl+Enter" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#EAF2FF;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="20" y="246" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f_leak" value="Blocked by the leakage check&#xa;a step that learns from data&#xa;runs before the split; checked in&#xa;the browser, then on the server" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FDECEC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="370" y="246" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a_run" value="Train model / Tune model&#xa;in the model node settings, or&#xa;Run All Experiments (toolbar,&#xa;shown for 2+ model nodes)" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#EAF2FF;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="680" y="246" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_preview" value="Preview on the server&#xa;up to 1,000 rows; model nodes&#xa;skipped; temporary files only,&#xa;no job is saved" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="20" y="386" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_run" value="Run on the server&#xa;one queued job per branch;&#xa;see Multi-Path Pipelines" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="680" y="386" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o_preview" value="Preview results panel&#xa;sample data for each path;&#xa;pass or fail mark on each node" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#F3E8FF;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="20" y="526" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t_job" value="Background job&#xa;trains or tunes the model&#xa;(Celery worker or in-process)" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#FFE9C7;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="680" y="526" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o_run" value="Where job results appear&#xa;job summary on the model node,&#xa;Jobs drawer and Jobs page,&#xa;Experiments view, Model Registry" style="rounded=1;html=0;arcSize=10;fontColor=#1A1A19;fontSize=12;fillColor=#F3E8FF;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="680" y="666" width="310" height="86" as="geometry" />
        </mxCell>
        <mxCell id="e_d1" value="data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_data" target="n_split">
          <mxGeometry relative="1" as="geometry" />
