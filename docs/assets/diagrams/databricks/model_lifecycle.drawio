<mxfile host="drawio" version="24.7.17">
  <diagram id="model-lifecycle" name="Model lifecycle">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1000" pageHeight="740" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Model lifecycle: from candidate to champion" style="text;html=0;fontSize=20;fontColor=#1A1A19;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="760" height="34" as="geometry" />
        </mxCell>
        <mxCell id="train" value="train job&#xa;fit and validate&#xa;a candidate" style="rounded=1;arcSize=10;html=0;fillColor=#FFF4E5;strokeColor=#D79B00;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="registered" value="Unity Catalog version&#xa;registered and set as&#xa;@challenger&#xa;(validation_status=pending)" style="rounded=1;arcSize=10;html=0;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="65" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="compare" value="Compare with @champion&#xa;on the same holdout:&#xa;quality gates, min_improvement,&#xa;coverage rules&#xa;validation_status: passed or&#xa;rejected; @challenger stays" style="rounded=1;arcSize=10;html=0;fillColor=#EAF7EE;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="55" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="policy" value="promotion_policy" style="rhombus;html=0;fillColor=#EAF7EE;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="60" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="report" value="training_report&#xa;shows approve and reject&#xa;values for Run now&#xa;(lifecycle_action)" style="rounded=1;arcSize=10;html=0;fillColor=#F3E8FF;strokeColor=#9673A6;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="280" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="promote" value="Promote&#xa;@champion -&gt; candidate&#xa;@previous_champion -&gt; old champion&#xa;@challenger cleared" style="rounded=1;arcSize=10;html=0;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="280" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="reject" value="Rejected&#xa;approval_status=rejected&#xa;aliases unchanged; cannot be&#xa;approved later" style="rounded=1;arcSize=10;html=0;fillColor=#FDECEC;strokeColor=#B85450;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="450" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rollback" value="Roll back&#xa;lifecycle_action=rollback with&#xa;the promotion receipt:&#xa;@champion -&gt; prior version" style="rounded=1;arcSize=10;html=0;fillColor=#FDECEC;strokeColor=#B85450;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="450" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="champion" value="@champion changed&#xa;(first champion,&#xa;promotion or rollback)" style="rounded=1;arcSize=10;html=0;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="280" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="score" value="score job&#xa;loads @champion only with&#xa;score_model_selection=champion;&#xa;a pinned version stays" style="rounded=1;arcSize=10;html=0;fillColor=#FFF4E5;strokeColor=#D79B00;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="640" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="serving" value="serving_endpoint job&#xa;puts the new @champion&#xa;behind the endpoint" style="rounded=1;arcSize=10;html=0;fillColor=#FFF4E5;strokeColor=#D79B00;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="640" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="caption" value="First model: with no @champion yet, approval or the automatic policy&#xa;sets the first @champion only when quality_threshold and every&#xa;quality gate pass. That change has no rollback.&#xa;Approve rechecks the saved holdout and that @champion is unchanged.&#xa;Dashed arrows are conditional runs or operator actions." style="text;html=0;fontSize=12;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="1">
