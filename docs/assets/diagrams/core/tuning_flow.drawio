        <mxCell id="k2" value="Learned state" style="rounded=1;html=0;arcSize=10;fillColor=#EAF7EE;strokeColor=#82B366;fontColor=#1A1A19;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="816" width="105" height="24" as="geometry" />
