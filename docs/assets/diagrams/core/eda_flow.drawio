<mxfile host="drawio" version="24.7.17">
  <diagram id="core-eda-flow" name="EDA flow">
    <mxGraphModel dx="1200" dy="1060" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1000" pageHeight="1060" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="EDAAnalyzer: what analyze() computes" style="text;html=0;fontSize=20;fontStyle=1;fontColor=#1A1A19;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="b_df" value="Polars DataFrame&#xa;EDAAnalyzer(df): NaN becomes&#xa;null; date-like strings&#xa;are cast to dates" style="rounded=1;html=0;arcSize=10;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b_opts" value="analyze() options&#xa;target_col, exclude_cols,&#xa;filters, task_type,&#xa;date_col, lat_col, lon_col" style="rounded=1;html=0;arcSize=10;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontColor=#1A1A19;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="50" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_over" value="1. Overview&#xa;filters and column exclusions applied;&#xa;row and column counts, duplicate rows,&#xa;missing-cell %, memory use" style="rounded=1;html=0;arcSize=10;fillColor=#FFF4E5;strokeColor=#D79B00;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="50" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_types" value="2. Column types&#xa;Numeric, Categorical, Boolean,&#xa;DateTime, Text (otherwise Unknown)" style="rounded=1;html=0;arcSize=10;fillColor=#FFF4E5;strokeColor=#D79B00;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="190" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_col" value="3. Per-column profiles&#xa;stats and histogram by type, missing count,&#xa;normality test, IQR outlier hint,&#xa;text length and sentiment (vaderSentiment)" style="rounded=1;html=0;arcSize=10;fillColor=#EAF7EE;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="310" width="420" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c_corr" value="4. Correlations&#xa;Pearson (pairwise, up to 20 columns)&#xa;and VIF for multicollinearity" style="rounded=1;html=0;arcSize=10;fillColor=#EAF7EE;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="444" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_target" value="5. Target analysis (if target_col is set)&#xa;numeric target: correlations, leakage check;&#xa;categorical target: eta association;&#xa;interactions with other columns" style="rounded=1;html=0;arcSize=10;fillColor=#EAF7EE;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="564" width="420" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c_multi" value="6. Multivariate&#xa;PCA, KMeans clusters (k=3),&#xa;Isolation Forest outlier rows" style="rounded=1;html=0;arcSize=10;fillColor=#EAF7EE;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="564" width="220" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c_opt" value="7. Optional modules&#xa;geo: lat/lon columns&#xa;time series: a date column&#xa;causal graph: PC algorithm&#xa;(causal-learn, eda extra)" style="rounded=1;html=0;arcSize=10;fillColor=#EAF7EE;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="554" width="220" height="104" as="geometry" />
        </mxCell>
        <mxCell id="c_rules" value="8. Decision-tree rules (if target_col is set)&#xa;a surrogate tree on the target&#xa;turned into readable rules" style="rounded=1;html=0;arcSize=10;fillColor=#EAF7EE;strokeColor=#82B366;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="698" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o_alerts" value="Alerts&#xa;High Null, Constant,&#xa;High Cardinality, Possible ID,&#xa;PII (email/phone), Outlier,&#xa;Multicollinearity, Leakage, ..." style="rounded=1;html=0;arcSize=10;fillColor=#F3E8FF;strokeColor=#9673A6;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="818" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o_recs" value="Recommendations&#xa;Drop, Impute, Transform,&#xa;Encode, Resample" style="rounded=1;html=0;arcSize=10;fillColor=#F3E8FF;strokeColor=#9673A6;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="828" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o_profile" value="DatasetProfile (one object)&#xa;columns, correlations, target results,&#xa;pca, clustering, outliers, causal_graph,&#xa;rule_tree, geospatial, timeseries" style="rounded=1;html=0;arcSize=10;fillColor=#F3E8FF;strokeColor=#9673A6;fontColor=#1A1A19;fontSize=12;" vertex="1" parent="1">
